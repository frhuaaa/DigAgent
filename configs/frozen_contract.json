{
  "version": 1,
  "round_budget": {
    "source": "task.trials",
    "max_adaptive_rounds": 10,
    "round0_excluded": true,
    "repeated_uncertain_or_falsified_limit": 10,
    "specialist_proposal_attempts_per_round": 2,
    "contract_correction_attempts_per_round": 1,
    "both_attempts_rejected_action": "RECORD_CONTRACT_REJECTED_AND_CONSUME_ROUND"
  },
  "run_storage": {
    "root_template": "runs/{task.instruments}_{agent.name_or_provider}_{task.prediction_mode}/{task.run_id}/{z_model.model_name}/{launch_MMDDHHMM}",
    "task_run_id_role": "required_four_digit_evidence_year_identifier",
    "launch_timestamp_is_always_separate": true,
    "shared_rass_evidence_template": "runs/{task.instruments}_{agent.name_or_provider}_{task.prediction_mode}/{task.run_id}/rass_train_evidence.json",
    "shared_rass_evidence_policy": "CACHE_ONLY_DETERMINISTIC_FACTOR_EVIDENCE; NEVER_CACHE_OR_REPLAY_AN_AGENT_SELECTED_FACTOR_SET; EVERY_TRAJECTORY_RUNS_A_FRESH_RASS_SELECTION",
    "shared_rass_evidence_context_hash_fields": [
      "task.instruments",
      "task.run_id",
      "task.prediction_mode",
      "z_alpha.feature_pool",
      "z_alpha.selected_features",
      "task.train_start_time",
      "task.train_end_time",
      "rass_evidence_periods",
      "target_label",
      "input_data_hash",
      "catalog_hash",
      "evidence_code_hash"
    ],
    "task_name_pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
    "mutable_subdirectories": [
      "configs",
      "experiments",
      "memory"
    ],
    "existing_run_policy": "RESUME_ONLY_IF_SUBMIT_PATH_AND_SHA256_MATCH",
    "mismatch_action": "FAIL_WITHOUT_OVERWRITE",
    "rapa_recovery_checkpoint_hash_source": "accepted_parent_config",
    "rapa_recovery_requires_reused_from_parent_match": true
  },
  "prediction_mode": {
    "source": "task.prediction_mode",
    "allowed": ["c2c", "o2o"],
    "default_for_legacy_submissions": "c2c",
    "single_switch_binds": [
      "task.target",
      "z_portfolio.ret_path",
      "z_portfolio.limit_up_mask_path",
      "z_portfolio.limit_down_mask_path",
      "z_portfolio.execution_price",
      "z_portfolio.return_definition",
      "z_portfolio.buy_slippage",
      "z_portfolio.sell_slippage"
    ],
    "c2c": {
      "target": "Ref($close, -2) / Ref($close, -1) - 1",
      "execution": "alpha[T] -> T+1 close -> close(T+2)/close(T+1)-1",
      "buy_slippage": 0.0005,
      "sell_slippage": 0.0005
    },
    "o2o": {
      "target": "Ref($open, -2) / Ref($open, -1) - 1",
      "execution": "alpha[T] -> T+1 open -> open(T+2)/open(T+1)-1",
      "buy_slippage": 0.001,
      "sell_slippage": 0.001
    },
    "rass_evidence_cache_identity_includes_prediction_mode": true
  },
  "clem": {
    "minimum_intervention_confidence": 0.5,
    "below_threshold_action": "INVALID_DECISION_RETRY_WITH_REQUIRED_LAYER_SELECTION",
    "allowed_routes_by_phase": {
      "while_five_factor_alpha_unresolved": ["RASS"],
      "after_alpha_freeze": ["FAMA", "RAPA"]
    },
    "stopping_rule": "ADAPTIVE_ROUND_BUDGET_EXHAUSTED"
  },
  "agent_runtime": {
    "config_path": "configs/agent_models.json",
    "selection_source": "submit.agent",
    "freeze_before_round0": true,
    "model_or_effort_change_requires_new_trajectory": true
  },
  "execution_device": {
    "request_source": "task.GPU",
    "cuda_index_is_zero_based": true,
    "startup_resolution": "use requested CUDA index only when torch.cuda.is_available() and index < torch.cuda.device_count(); otherwise use cpu",
    "startup_unavailable_action": "WARN_AND_USE_CPU",
    "freeze_resolved_device_before_round0": true,
    "record_in_initial_provenance": [
      "requested_device",
      "resolved_device",
      "fallback_reason",
      "torch_version",
      "cuda_runtime_version"
    ],
    "mid_trajectory_cuda_failure_action": "FATAL_NO_DEVICE_SWITCH"
  },
  "model_ensemble": {
    "enabled": true,
    "seeds": [0, 1, 2],
    "parallel_gpu_workers": 3,
    "checkpoint_selection": "INDEPENDENT_MAX_TRAIN_VALID_IC_PER_SEED",
    "prediction_combination": "PER_SEED_DAILY_CROSS_SECTIONAL_WINSORIZE_ZSCORE_THEN_EQUAL_WEIGHT_MEAN_THEN_RENORMALIZE",
    "canonical_agent_valid_alpha": "ENSEMBLE_ONLY",
    "canonical_test_alpha": "ENSEMBLE_ONLY",
    "rapa_reuses": "ALL_THREE_ACCEPTED_CHECKPOINTS_AND_CANONICAL_ENSEMBLE_ALPHA",
    "adaptive_comparison": "ENSEMBLE_CANDIDATE_VS_ENSEMBLE_ACCEPTED_PARENT"
  },
  "result_contract": {
    "schema_path": "schemas/result.schema.json",
    "top_level_field_count": 27,
    "metric_field_count": 26,
    "integer_field": "n_periods",
    "float_serialization_decimals": 3,
    "excess_return_definition": "strategy_net_daily_return - aligned_benchmark_daily_return",
    "excess_sharpe_field": "information_ratio"
  },
  "adaptive_objective": {
    "primary_metric": "validation_sharpe_ratio",
    "return_series": "strategy_net_daily_return",
    "objective_role": "global_gate_objective_with_explicit_fama_validation_ic_promotion_override",
    "objective_sign_is_not_a_routing_gate": true,
    "excess_and_benchmark_relative_metrics_role": "diagnostic_only",
    "excess_metrics_may_independently_trigger_intervention": false,
    "excess_metrics_may_independently_trigger_rapa": false,
    "rapa_requires_structured_primary_objective_assessment": true,
    "rapa_primary_objective_observed_value_must_match_result_json": true,
    "rapa_requires_validation_supported_portfolio_opportunity": true,
    "positive_validation_sharpe_blocks_rapa": false,
    "turnover_target_or_reference": null
  },
  "researcher_test_output": {
    "enabled_per_round": true,
    "required_for_every_successfully_executed_round": true,
    "directory": "experiments/{experiment_id}/test",
    "per_epoch_model_metrics": {
      "enabled": true,
      "timing": "IMMEDIATELY_AFTER_EACH_EPOCH_CHECKPOINT",
      "execution_boundary": "SEPARATE_RESEARCHER_SIDE_EVALUATOR",
      "log_path": "experiments/{experiment_id}/test/epoch_metrics.jsonl",
      "record_contains": [
        "epoch",
        "checkpoint_id",
        "train_ic",
        "train_icir",
        "train_rank_ic",
        "train_rank_icir",
        "valid_ic",
        "valid_icir",
        "valid_rank_ic",
        "valid_rank_icir",
        "test_ic",
        "test_icir",
        "test_rank_ic",
        "test_rank_icir"
      ],
      "trainer_receives_test_metrics": false
    },
    "selected_checkpoint_full_test_timing": "AFTER_VALIDATION_CHECKPOINT_AND_ADAPTIVE_OUTPUTS_ARE_SEALED",
    "result_path": "experiments/{experiment_id}/test/result.json",
    "result_schema_path": "schemas/result.schema.json",
    "result_float_serialization_decimals": 3,
    "optional_artifacts": [
      "experiments/{experiment_id}/test/test_alpha.csv",
      "experiments/{experiment_id}/test/portfolio_daily_diagnostics.csv"
    ],
    "adaptive_read_access": false,
    "researcher_job_failure_changes_adaptive_state": false,
    "may_affect_checkpoint_routing_gate_memory_acceptance_rollback_or_stopping": false,
    "post_trajectory_audit": {
      "path": "test/researcher_outputs_audit.json",
      "runs_in_isolated_subprocess": true,
      "reports_presence_and_valid_completion_only": true,
      "contains_test_metrics": false,
      "affects_adaptive_state": false
    }
  },
  "portfolio_feasibility": {
    "asset_universe_column_policy": "FINITE_ALPHA_INTERSECTION_RETURN_LIMIT_UP_LIMIT_DOWN_HEADERS",
    "predicted_asset_missing_from_any_portfolio_panel": "EXCLUDE_AND_AUDIT_NOT_FATAL",
    "admitted_asset_missing_daily_mask_value": "CONSERVATIVELY_BLOCK_RELEVANT_DIRECTION",
    "target_invested_weight": 1.0,
    "infeasible_full_investment_action": "INVEST_MAXIMUM_FEASIBLE_AND_HOLD_CASH",
    "cash_daily_return": 0.0,
    "relax_asset_or_directional_bounds": false,
    "infeasibility_is_fatal": false,
    "daily_diagnostic_fields": [
      "target_invested_weight",
      "feasible_min_invested_weight",
      "feasible_max_invested_weight",
      "full_position_feasible",
      "invested_weight",
      "invested_weight_shortfall",
      "feasibility_reason_code"
    ],
    "shortfall_is_tradeoff_guardrail": true
  },
  "sharpe_noise": {
    "method": "fixed_symmetric_threshold",
    "epsilon_sharpe": 0.002,
    "epsilon_definition": "IMPROVED if delta > 0.002; WORSE if delta < -0.002; otherwise UNCHANGED",
    "insufficient_data_verdict": "UNCERTAIN"
  },
  "hard_performance_constraints": [],
  "data_integrity_and_contract_failures_remain_fatal": true,
  "validation_gate": {
    "acceptance_rule_status": "FROZEN",
    "acceptance_metric": "validation_sharpe_plus_mechanism_tradeoff_and_predeclared_stability_with_fixed_sharpe_epsilon",
    "sharpe_acceptance_delta": 0.002,
    "acceptance_comparison": "classify Sharpe with fixed epsilon 0.002, then apply the frozen mechanism/trade-off matrix and predeclared partial-promotion stability checks",
    "numerical_equivalence": {
      "absolute_tolerance": 1e-12,
      "relative_tolerance": 1e-10,
      "tolerance_definition": "max(absolute_tolerance, relative_tolerance * max(abs(parent_statistic), abs(candidate_statistic)))",
      "delta_at_or_below_tolerance": "CANONICALIZE_TO_ZERO",
      "effective_epsilon_definition": "Sharpe uses fixed 0.002; mechanism and trade-off metrics use max(bootstrap_epsilon, numerical_equivalence_tolerance)",
      "applies_to": [
        "sharpe",
        "mechanism_metrics",
        "tradeoff_guardrails"
      ]
    },
    "secondary_metrics_affect_verdict": true,
    "mechanism_match_affects_verdict": true,
    "tradeoff_guardrails_affect_verdict": true,
    "formal_adaptation_allowed_by_gate_contract": true,
    "promotion_verdicts": [
      "SUPPORTED",
      "PARTIALLY_SUPPORTED"
    ],
    "partially_supported_promotion_stability": {
      "status": "FROZEN",
      "temporal_method": "split aligned agent-valid daily net returns into two fixed chronological halves",
      "minimum_periods_per_half": 20,
      "temporal_pass": "neither half is WORSE and at least one half is IMPROVED using the same fixed Sharpe epsilon 0.002",
      "model_or_alpha_rerun_seed_pass": "all three seed IC deltas are available, at least two are nonnegative, and the median is nonnegative",
      "rapa_seed_pass": "NOT_APPLICABLE_BECAUSE_RAPA_REUSES_THE_ACCEPTED_ENSEMBLE_ALPHA",
      "failure_action": "DOWNGRADE_PROVISIONAL_PARTIALLY_SUPPORTED_TO_UNCERTAIN",
      "test_evidence_allowed": false
    },
    "fama_validation_ic_promotion_override": {
      "enabled": true,
      "applies_only_to_agent": "FAMA",
      "metric": "mean_daily_validation_ic",
      "epsilon_ic": 0.001,
      "promotion_condition": "ordinary verdict is UNCERTAIN; ensemble delta_valid_ic > 0.001; at least two of three seed IC deltas are positive; median seed delta_valid_ic > 0.001; no worse full-window Sharpe, no material Sharpe reversal in either fixed chronological half, no opposite mechanism, and no material trade-off",
      "equality_action": "NO_OVERRIDE",
      "may_override_falsified": false,
      "ordinary_gate_verdict_is_preserved_for_audit": true,
      "promotion_reason": "fama_validation_ic_override",
      "gate_verdict_usage": "overridden_by_fama_validation_ic",
      "test_evidence_allowed": false
    },
    "rass_bounded_initial_search": {
      "agent": "RASS",
      "group": "initial_feature_bootstrap",
      "maximum_failed_executed_candidates": 3,
      "each_candidate_parent": "EXP_000_FIVE_FACTOR_ACCEPTED_BASELINE",
      "candidate_set_rule": "THREE_ADDITIONS_MAY_PARTIALLY_OVERLAP_BUT_COMPLETE_UNORDERED_SET_MUST_NOT_REPEAT",
      "selection_mode": "agent_exploration_using_previous_three_complete_calendar_years",
      "deterministic_selector_forbidden": true,
      "allowed_initial_feature_counts": [5],
      "required_added_feature_count_rule": "8 - initial_feature_count",
      "required_final_feature_count": 8,
      "rass_exploration_stages": 2,
      "agent_shortlist_size": 12,
      "final_selection_must_be_subset_of_shortlist": true,
      "shortlist_and_final_selection_data": "RASS_DEVELOPMENT_Y_MINUS_3_THROUGH_Y_MINUS_1",
      "development_evidence_year_rule": ["Y-3", "Y-2", "Y-1"],
      "last_usable_signal_date_rule": "third_from_last_qlib_trading_date_of_each_calendar_year",
      "test_visible_to_rass": false,
      "deterministic_candidate_eligibility": {
        "minimum_total_coverage": 0.9,
        "minimum_valid_ic_date_ratio": 0.8,
        "minimum_nonconstant_cross_section_ratio": 0.9,
        "duplicate_anchor_forbidden": true,
        "eligibility_is_not_factor_ranking": true
      },
      "stage1_redundancy_estimation": {
        "method": "deterministic_evenly_spaced_row_sample",
        "maximum_rows": 20000
      },
      "fixed_rolling_rass_development_evidence": {
        "method": "three_complete_calendar_years_before_task_run_id",
        "period_rule": ["Y-3", "Y-2", "Y-1"],
        "label_alignment": "purge each period's final two trading signal dates so T+2 remains inside the period",
        "test_used": false,
        "agent_judgment_not_fixed_weighted_score": true
      },
      "stage2_joint_evidence_uses_full_train_daily_cross_sections": true,
      "preserve_initial_features_and_order": true,
      "requires_contract_pass": true,
      "requires_successful_complete_execution": true,
      "gate_verdict_controls_promotion": true,
      "promotion_verdicts": ["SUPPORTED", "PARTIALLY_SUPPORTED"],
      "rejected_candidate_action": "ROLL_BACK_TO_EXP_000_AND_RESELECT_THREE_FACTORS",
      "third_failure_action": "FREEZE_ORIGINAL_FIVE_FACTOR_ALPHA_AND_CONTINUE_WITH_FAMA_OR_RAPA",
      "contract_or_runtime_failure_counts_as_candidate_failure": false,
      "freeze_catalog_and_evidence_after_promotion": true,
      "later_rass_routes_forbidden_after_acceptance_or_three_failure_fallback": true,
      "post_bootstrap_routes": ["FAMA", "RAPA"]
    },
    "sharpe_states": {
      "IMPROVED": "delta_sharpe > 0.002",
      "UNCHANGED": "-0.002 <= delta_sharpe <= 0.002",
      "WORSE": "delta_sharpe < -0.002"
    },
    "mechanism_states": {
      "MATCH": "every declared target metric improves in its expected direction by more than its bootstrap epsilon",
      "PARTIAL": "at least one but not every declared target metric improves by more than epsilon, and none worsens by more than epsilon",
      "INCONCLUSIVE": "every declared target metric remains within its bootstrap epsilon",
      "OPPOSITE": "at least one declared target metric moves opposite to its expected direction by more than its bootstrap epsilon"
    },
    "tradeoff": {
      "noise_method": "same paired moving-block bootstrap parameters as sharpe_noise",
      "metric_epsilon_definition": "max(1.96 * std(bootstrap_oriented_metric_delta, ddof=1), numerical_equivalence_tolerance(parent_metric, candidate_metric))",
      "material_degradation_definition": "observed_oriented_metric_delta > metric_epsilon",
      "guardrails": [
        {
          "metric": "max_drawdown_magnitude",
          "definition": "abs(max_drawdown)",
          "higher_is_worse": true
        },
        {
          "metric": "annual_volatility",
          "higher_is_worse": true
        },
        {
          "metric": "portfolio_concentration_mean",
          "definition": "mean daily sum(weight_i ** 2)",
          "higher_is_worse": true
        },
        {
          "metric": "invested_weight_shortfall_mean",
          "definition": "1 - invested_weight_mean",
          "higher_is_worse": true
        }
      ],
      "diagnostic_only_not_tradeoff_guardrails": [
        "one_way_turnover_mean",
        "transaction_cost_drag_mean",
        "alpha_term_mean"
      ],
      "missing_required_guardrail_action": "UNCERTAIN"
    },
    "partially_supported_enabled": true,
    "partially_supported_accepts_candidate": true,
    "verdict_order": [
      "if sharpe_state == WORSE: FALSIFIED",
      "else if mechanism_state == OPPOSITE: FALSIFIED",
      "else if tradeoff has material degradation: FALSIFIED",
      "else if required sharpe, mechanism, or guardrail evidence is unavailable: UNCERTAIN",
      "else if sharpe_state == IMPROVED and mechanism_state == MATCH: SUPPORTED",
      "else if sharpe_state == IMPROVED and partial-promotion stability passes: PARTIALLY_SUPPORTED",
      "else if sharpe_state == UNCHANGED and mechanism_state in [MATCH, PARTIAL] and partial-promotion stability passes: PARTIALLY_SUPPORTED",
      "else: UNCERTAIN"
    ],
    "sharpe_worse_other_metrics_improve_accepts_candidate": false
  },
  "memory_retrieval": {
    "top_k": null,
    "retrieve_entire_validation_safe_memory_each_round": true,
    "ordering": [
      "round_ascending",
      "experiment_id_ascending"
    ],
    "role_specific_projection_allowed": true,
    "truncation_allowed": false
  },
  "anti_repetition": {
    "same_accepted_parent_rejected_parameter_retry": "FORBIDDEN",
    "rapa_directional_search_exception": "THE_SAME_RAPA_PARAMETER_MAY_REVERSE_AFTER_REJECTION_BUT_AN_ALREADY_TESTED_NUMERIC_VALUE_MAY_NOT_BE_REPEATED",
    "rejected_verdicts": [
      "FALSIFIED",
      "UNCERTAIN"
    ],
    "accepted_parent_change_resets_parameter_eligibility": true,
    "contract_rejected_attempts_are_recorded_in_memory": true,
    "three_consecutive_unaccepted_same_layer": {
      "threshold": 3,
      "accepted_value": false,
      "contract_rejected_counts_as_unaccepted": true,
      "next_round_action": "FORCE_THE_OTHER_OF_FAMA_OR_RAPA_AND_REQUIRE_REDIAGNOSIS",
      "cooldown_rounds": 1
    }
  },
  "intervention_spaces": {
    "FAMA": "agents/FAMA/intervention_space.yaml",
    "RAPA": "agents/RAPA/intervention_space.yaml",
    "RASS": "agents/RASS/intervention_space.yaml",
    "RAPA_directional_search": {
      "adaptive_parameters": ["risk_aversion", "turnover_penalty"],
      "frozen_parameters": ["alpha_scale"],
      "maximum_attempts_per_parameter": 4,
      "initial_probe_max_absolute_step": 0.1,
      "accepted_trial_action": "CONTINUE_SAME_DIRECTION_WITH_NON_SHRINKING_STEP",
      "rejected_trial_action": "ROLLBACK_AND_REVERSE_WITH_LOCAL_STEP_AT_MOST_0.1",
      "best_value_policy": "VALIDATION_GATE_PROMOTION_AND_ROLLBACK",
      "fifth_refinement_trial": "FORBIDDEN"
    }
  }
}
