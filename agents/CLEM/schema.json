{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "selected_agent": {
      "type": "string",
      "enum": [
        "RASS",
        "FAMA",
        "RAPA"
      ]
    },
    "selected_layer": {
      "type": "string",
      "enum": [
        "alpha",
        "model",
        "portfolio"
      ]
    },
    "failure_summary": {
      "type": "string"
    },
    "supporting_evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "why_not_other_layers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "intervention_goal": {
      "type": "string",
      "minLength": 1
    },
    "confidence": {
      "type": "number",
      "minimum": 0.5,
      "maximum": 1
    },
    "primary_objective_assessment": {
      "type": "object",
      "properties": {
        "metric": {
          "const": "validation_sharpe_ratio"
        },
        "observed_value": {
          "type": "number"
        },
        "failure_supported": {
          "type": "boolean"
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "metric",
        "observed_value",
        "failure_supported",
        "rationale"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "selected_agent",
    "selected_layer",
    "failure_summary",
    "supporting_evidence",
    "why_not_other_layers",
    "intervention_goal",
    "confidence"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "selected_agent": {
            "const": "RASS"
          }
        }
      },
      "then": {
        "properties": {
          "selected_layer": {
            "const": "alpha"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "selected_agent": {
            "const": "FAMA"
          }
        }
      },
      "then": {
        "properties": {
          "selected_layer": {
            "const": "model"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "selected_agent": {
            "const": "RAPA"
          }
        }
      },
      "then": {
        "required": [
          "primary_objective_assessment"
        ],
        "properties": {
          "selected_layer": {
            "const": "portfolio"
          }
        }
      }
    }
  ]
}
