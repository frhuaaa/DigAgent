{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "agent": {"const": "RASS"},
    "method": {"const": "agent_factor_exploration"},
    "data_split": {"const": "rass_development"},
    "selected_group": {"const": "initial_feature_bootstrap"},
    "target_subset_size": {"const": 8},
    "initial_features": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"type": "string"}},
    "removed_features": {"type": "array", "maxItems": 0, "items": {"type": "string"}},
    "added_features": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "object", "properties": {"id": {"type": "string"}, "expression": {"type": "string"}}, "required": ["id", "expression"], "additionalProperties": false}},
    "selected_features": {"type": "array", "minItems": 8, "maxItems": 8, "items": {"type": "string"}},
    "hypothesis": {"type": "string", "minLength": 1},
    "local_diagnosis": {"type": "string", "minLength": 1},
    "reasoning": {"type": "string", "minLength": 1},
    "alternatives_considered": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "expected_signature": {"type": "array", "minItems": 1, "items": {"type": "object", "properties": {"metric": {"enum": ["ic", "icir", "rank_ic", "rank_icir", "sharpe_ratio"]}, "direction": {"enum": ["increase", "stable_or_improve"]}}, "required": ["metric", "direction"], "additionalProperties": false}},
    "falsification_condition": {"type": "string", "minLength": 1},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "evidence_frozen_after_success": {"const": true},
    "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "provenance": {"type": "object", "properties": {"data_hash": {"type": "string"}, "catalog_hash": {"type": "string"}, "label_hash": {"type": "string"}, "evidence_context_hash": {"type": "string"}, "evidence_code_hash": {"type": "string"}, "shortlist_evidence_hash": {"type": "string"}}, "required": ["data_hash", "catalog_hash", "label_hash", "evidence_context_hash", "evidence_code_hash", "shortlist_evidence_hash"], "additionalProperties": false}
  },
  "required": ["agent", "method", "data_split", "selected_group", "target_subset_size", "initial_features", "removed_features", "added_features", "selected_features", "hypothesis", "local_diagnosis", "reasoning", "alternatives_considered", "expected_signature", "falsification_condition", "confidence", "evidence_frozen_after_success", "evidence_refs", "provenance"],
  "additionalProperties": false
}
